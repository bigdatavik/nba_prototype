# =============================================================================
# Example environment configuration for the NBA Prototype
# =============================================================================
# Copy to `.env` and adjust for your workspace. These override the bundle
# variable defaults when running the CLI, e.g.:
#
#   databricks bundle deploy -t dev --var="uc_catalog=my_catalog"
#
# The bundle (databricks.yml) is the source of truth; this file documents the
# knobs and is handy for local/manual runs. Nothing here is a secret — auth is
# handled by your Databricks CLI profile (OAuth), not stored credentials.
# =============================================================================

# --- Workspace / auth ---
DATABRICKS_CONFIG_PROFILE=DEFAULT

# --- Unity Catalog source ---
UC_CATALOG=nba_demo
UC_SCHEMA=nba_new

# --- Lakebase ---
LAKEBASE_PROJECT=lakebase-demo-autoscale
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_SCHEMA=nba_new_lbase
LAKEBASE_BRANCH_PRODUCTION=production
LAKEBASE_BRANCH_APP_WRITES=app-writes

# --- Model serving ---
MODEL_ENDPOINT_NAME=nba-scoring-endpoint

# --- App ---
# Leave NBA_CONSOLE_SP blank to auto-resolve the app's service principal.
NBA_CONSOLE_SP=
